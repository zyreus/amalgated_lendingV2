# Copy to `.env` or `.env.development.local` for local dev.

# Laravel requires PHP 8.3+ (composer.json). XAMPP 8.2 will cause HTTP 500 on /api/v1/*.
# serve-laravel auto-detects WinGet PHP 8.3; override if needed:
# PHP 8.3+ for Laravel (required). XAMPP's `php` is often 8.2 — do not use it for artisan.
# WinGet example (adjust to your machine):
# PHP_BINARY=C:/Users/you/AppData/Local/Microsoft/WinGet/Packages/PHP.PHP.8.3_.../php.exe

# Laravel API port (must match `php artisan serve` / scripts/serve-laravel.cjs)
LARAVEL_PORT=8000

# Vite proxy: browser calls `/api/*` → this origin (must match LARAVEL_PORT / serve-laravel; default 8000)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Laravel web route for signed borrower email links (same as amalgated-lending-api BORROWER_VERIFY_URL_BASE)
VITE_BORROWER_VERIFY_URL_BASE=http://127.0.0.1:8000

# Optional: admin header clock skin for the React CRM (`minimal` | `glass` | `premium`). Default: minimal.
# VITE_ADMIN_HEADER_CLOCK_VARIANT=minimal

# Optional: Laravel axios timeout (ms) for large multipart uploads (defaults in lendingLaravelApi.js).
# VITE_LENDING_REQUEST_TIMEOUT_MS=120000

# Borrower liveness and all other JWT routes: POST/GET https://<host>/api/v1/...
# Example: POST http://localhost:6174/api/v1/liveness/verify (proxied to Laravel; Vite `server.port` is 6174).
# Camera (getUserMedia): use HTTPS or http://localhost (or 127.0.0.1).

# FaceIO (fio.js) — public app ID from https://faceio.net — used by Identity Verification
# VITE_FACEIO_PUBLIC_ID=

# AWS Amplify Face Liveness (FaceLivenessDetector): Cognito Identity Pool (guest) in same region as LIVENESS_AMPLIFY_REGION
# VITE_AWS_COGNITO_IDENTITY_POOL_ID=

# Optional: admin chat bridge (same secret as chat-server/.env when used)
# VITE_LENDING_ADMIN_API_SECRET=

# Website ↔ Admin CRM warehouse: chat-server/.env sets LARAVEL_CHAT_SYNC_URL + LARAVEL_CHAT_SYNC_SECRET;
# amalgated-lending-api/.env sets SUPPORT_CHAT_SYNC_SECRET (must match). See chat-server/.env.example.

# Node chat server (Socket.IO + CRM). Defaults to http://127.0.0.1:8010 in dev if unset — do NOT point at Laravel.
# VITE_CHAT_DEV_ORIGIN=http://127.0.0.1:8010
# VITE_CHAT_PROXY_TARGET=http://127.0.0.1:8010
# Production chat host (Node CRM + Socket.IO). Use origin or https://chat.domain.com/api — code uses URL.origin.
# VITE_CHAT_SERVER_URL=https://chat.amalgatedlending.com
# VITE_CHAT_API_URL=https://chat.amalgatedlending.com/api
# Optional override for WebSocket origin only:
# VITE_CHAT_WS_URL=wss://chat.amalgatedlending.com

# Only if Node chat shares the SPA hostname (proxied `/api/admin` + `/socket.io`): allow same-origin retries.
# Omit for chat.* subdomain setups (preferred).
# VITE_CHAT_SAME_ORIGIN_FALLBACK=1

# --- cPanel / production (amalgatedlending.com) ---
# Copy `.env.production.example` → `.env.production`, adjust hosts, then:
#   npm run build:laravel
# That builds Vite to `dist/` and copies `dist/index.html` + `dist/assets/` into `amalgated-lending-api/public/`
# so `/assets/*.js` loads when Apache/IIS document root is Laravel `public/`.
# Optional: set SPA_INDEX_PATH in `amalgated-lending-api/.env` to an absolute `index.html` path.
