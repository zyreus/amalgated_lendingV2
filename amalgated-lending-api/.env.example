# Use quotes if the name contains spaces (unquoted values break dotenv parsing and the whole app returns HTTP 500).
APP_NAME="Amalgated Lending"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# IMPORTANT: In production, APP_URL must be your public API origin (never 127.0.0.1 / localhost).
# Example: APP_URL=https://api.amalgatedlending.com

# Filament panel URL segment. Use `filament` (default) so `/admin` is free for the Vite React staff app on the public site.
FILAMENT_PATH=filament

# Optional absolute path to built `index.html` (defaults to ../dist/index.html from the API folder, then public/index.html).
# SPA_INDEX_PATH=

# Optional: origin where /print/* is served (signed loan form & SOA). The HMAC includes this host.
# If APP_URL is production but you run Laravel on http://127.0.0.1:8001, set this to that local URL.
# LENDING_PUBLIC_BASE_URL=http://127.0.0.1:8001

# React/Vite dev server — password-reset emails link here (see AppServiceProvider).
# Must match `server.port` in frontend/vite.config.js (5174).
FRONTEND_URL=http://localhost:5174
# Optional explicit URL base for borrower verification emails.
# Use this when workers/CLI may run with a different host context.
# BORROWER_VERIFY_URL_BASE=https://api.amalgatedlending.com

# Optional extra API CORS origins (comma-separated, no trailing slash). Merged with FRONTEND_URL and production defaults in config/cors.php.
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Laravel lending API only — separate from amalgated_holdings (Holdings) and amalgated_lending_chat (Node chat CRM).
DB_DATABASE=amalgated_lending_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Uploads use disk `public` (storage/app/public). JSON URLs use /api/v1/public-files/… so the SPA proxy works without tuning APP_URL.
# For Filament / legacy tools still run: php artisan storage:link (links public/storage → storage/app/public).

QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_CONNECTION=
SESSION_STORE=
SESSION_LIFETIME=120

# Local XAMPP without Redis: use file/session + sync queue (Horizon will not run; jobs execute inline when dispatched sync).
# CACHE_DRIVER=file
# SESSION_DRIVER=file
# QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default
HORIZON_PREFIX=amalgated_lending_horizon:
HORIZON_PATH=horizon

# ── Mail: local dev — MailHog on 127.0.0.1:1025 (or set MAIL_MAILER=log to write to storage/logs). Production: Brevo SMTP. ──
MAIL_MAILER=smtp
# Use 127.0.0.1 on Windows/host; Docker service name "mailhog" only works inside the same compose network.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo (https://www.brevo.com/) — transactional email for Amalgated Lending API.
#
# (A) REST API — used by Admin CRM “Email lead”, borrower/admin forgot-password, payment receipts when set.
#     Create key: Brevo → SMTP & API → API keys. Sender must be verified (Domains or single sender).
#     Receipt flow: Brevo API → then Brevo SMTP (if BREVO_SMTP_* set) → then MAIL_MAILER (e.g. smtp/MailHog).
#     Windows: if API fails with cURL SSL error 60, either install CA bundle (curl.cainfo in php.ini) or set below to false on dev only.
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL=noreply@yourdomain.com
# BREVO_SENDER_NAME="Amalgated Lending"
# Optional absolute logo URL for email templates.
# MAIL_LOGO_URL=https://amalgatedlending.com/amalgated-lending-logo.svg
# BREVO_API_ENDPOINT=https://api.brevo.com/v3
# BREVO_TIMEOUT=30
# BREVO_HTTP_VERIFY_SSL=true
#
# (B) SMTP — Brevo relay used as fallback when API fails and for Mail:: when MAIL_MAILER=brevo.
#     Brevo → SMTP & API → SMTP → copy login + SMTP key. Same verified sender rules as API.
# MAIL_MAILER=brevo
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_ENCRYPTION=tls
# BREVO_SMTP_LOGIN=your-login@example.com
# BREVO_SMTP_KEY=xsmtp-...
# MAIL_FROM_ADDRESS and MAIL_FROM_NAME must match a verified sender in Brevo.

# ── AWS (Rekognition) — borrower liveness POST /api/v1/liveness/verify
# IAM: allow rekognition:CompareFaces in AWS_DEFAULT_REGION.
# Reference face: borrower must have a loan with face_photo_path (KYC apply); else API returns 422.
# Frontend camera: HTTPS or http://localhost|127.0.0.1 (getUserMedia).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Liveness (optional — defaults in config/liveness.php)
# LIVENESS_MAX_ATTEMPTS_24H=3
# LIVENESS_MIN_SIMILARITY=85
# LIVENESS_MAX_IMAGE_BYTES=2097152
# FaceIO POST /api/v1/liveness/faceio-verify (must match frontend VITE_FACEIO_PUBLIC_ID app)
# FACEIO_MIN_CONFIDENCE=0.8

# Face Liveness (Amplify UI) — CreateFaceLivenessSession / GetFaceLivenessSessionResults (region must support Face Liveness)
# LIVENESS_AMPLIFY_REGION=us-east-1
# LIVENESS_AMPLIFY_MIN_CONFIDENCE=80

# Face recognition — single image match POST /api/v1/face/verify (config/face_verification.php)
# FACE_VERIFY_MAX_ATTEMPTS_24H=3
# FACE_VERIFY_MIN_SIMILARITY=85
# FACE_VERIFY_MAX_IMAGE_BYTES=2097152

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Amalgated Lending API ──
# First-time admin user (DatabaseSeeder). Override in production.
# ADMIN_SEED_USERNAME=admin
# ADMIN_SEED_PASSWORD=admin123

# REQUIRED if chat-server mirrors site chat into Laravel (visitor lines in Admin CRM). Same string as chat-server LARAVEL_CHAT_SYNC_SECRET.
SUPPORT_CHAT_SYNC_SECRET=amalgated-local-chat-warehouse-sync-v1

# Chat RAG (Groq chat-server calls POST /api/v1/internal/chat/rag/context with X-Support-Sync-Secret).
# After migrate, run: php artisan chat:knowledge-sync
# CHAT_KNOWLEDGE_PUBLIC_SITE_URL=https://amalgatedlending.com
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Max knowledge chunks scanned per RAG request (lower = faster; default 48).
# CHAT_KNOWLEDGE_RAG_POOL=48

# Laravel → Node Socket.IO relay (instant visitor widgets). Same secret as chat-server CHAT_INTERNAL_BROADCAST_SECRET.
# Full URL INCLUDING path (see config/services.php `node_chat`).
# NODE_CHAT_BROADCAST_URL=http://127.0.0.1:8010/api/internal/chat-broadcast/message
# NODE_CHAT_BROADCAST_SECRET=

# ── Production (amalgatedlending.com) ──
# Recommended: SPA at https://amalgatedlending.com, API subdomain docroot → Laravel `public/`.
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=base64:...   (php artisan key:generate — never commit real .env)
# APP_URL=https://api.amalgatedlending.com
# FRONTEND_URL=https://amalgatedlending.com
# BORROWER_VERIFY_URL_BASE=https://api.amalgatedlending.com
#
# SANCTUM_STATEFUL_DOMAINS=amalgatedlending.com,www.amalgatedlending.com,api.amalgatedlending.com
#
# DB_* from your MySQL provider (host often localhost). Example database name from phpMyAdmin:
# DB_DATABASE=acilending_cpuser_lending
# DB_USERNAME=…
# DB_PASSWORD=…
# Run `php artisan migrate --force` on the server after first deploy.
