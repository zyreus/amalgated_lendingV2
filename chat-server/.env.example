# Amalgated Lending Inc. — Node chat/API server (this folder).
# Copy to .env and adjust. Run: npm install && npm start (or use npm run serve:chat from ../).

PORT=8010

# Production: comma-separated SPA origins allowed to use Socket.IO + REST (no trailing slashes). Leave empty in local dev (allows all).
# Point DNS chat.amalgatedlending.com at this Node app; set the same origin in the SPA build (VITE_CHAT_SERVER_URL).
# CHAT_CORS_ORIGINS=https://amalgatedlending.com,https://www.amalgatedlending.com
# If CRM shows CORS errors like Access-Control-Allow-Origin "multiple values" for the SAME URL, nginx/Apache/Cloudflare
# is ALSO sending ACAO alongside Node — disable proxy CORS for chat.* (pick ONE layer).
# Behind nginx/Apache TLS termination: TRUST_PROXY=1
# TRUST_PROXY=1
# TRUST_PROXY_HOPS=1

# Optional: when ../dist is missing, redirect browser hits on this server to Vite (dev only).
# VITE_DEV_SERVER_URL=http://localhost:5173

# Must match VITE_LENDING_ADMIN_API_SECRET (or VITE_CHAT_API_SECRET) in ../.env (min 8 chars).
LENDING_ADMIN_API_SECRET=amalgated-local-chat-secret-v1

JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ── Database (choose one)
# MySQL (recommended): Node CRM tables live in amalgated_lending_chat (NOT Laravel's amalgated_lending_db).
# The server creates the database and tables on startup if MYSQL is reachable.
DB_PROVIDER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=amalgated_lending_chat

# SQLite (dev fallback): set DB_PROVIDER=sqlite and optional DB_PATH
# DB_PROVIDER=sqlite
# DB_PATH=chat.db

# Groq AI for visitor chat (optional). Without a key, rule-based replies still work.
# Put the real key only in .env (never commit). No quotes around the key. Server tries model fallbacks if one is retired.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MAX_TOKENS=512
# GROQ_TEMPERATURE=0.65
# When unset, visitor lending chat always uses Groq (+ RAG when configured). Set to 1 to use canned FAQ fallbacks for short keyword matches (saves API calls; skips richer answers).
# GROQ_FAST_LENDING_FAQ=1
# GROQ_FAST_LENDING_FAQ_MAX_CHARS=96

# Optional: UTF-8 text file appended to the lending AI FAQ (Groq system prompt). Restart server after edits.
# Paths relative to this folder (cwd when you run npm start) or absolute.
# LENDING_AI_FAQ_PATH=./ai/my-lending-notes.txt

# ── REQUIRED for Admin CRM (MySQL warehouse): mirrors visitor/customer texts + AI/agent lines from Node.
# Laravel: amalgated-lending-api/.env → SUPPORT_CHAT_SYNC_SECRET must equal LARAVEL_CHAT_SYNC_SECRET here.
# URL = Laravel API base INCLUDING /api/v1 (no trailing slash). Restart Node after editing.
LARAVEL_CHAT_SYNC_URL=http://127.0.0.1:8001/api/v1
LARAVEL_CHAT_SYNC_SECRET=amalgated-local-chat-warehouse-sync-v1
# Same Laravel base + secret used for RAG (verified website excerpts per visitor message). Disable with CHAT_RAG_ENABLED=0.
# CHAT_RAG_ENABLED=1
# CHAT_RAG_TIMEOUT_MS=10000

# Laravel staff replies → Socket.IO (`POST /api/internal/chat-broadcast/message`). Same value as Laravel NODE_CHAT_BROADCAST_SECRET.
# CHAT_INTERNAL_BROADCAST_SECRET=

# ── Email — Google Workspace SMTP (careers/news notifications, chat escalations, etc.)
# Create App Password: Google Account → Security → 2-Step Verification → App passwords.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=support@amalgatedlending.com
# SMTP_PASS=your-google-app-password
# MAIL_FROM="Amalgated Lending <support@amalgatedlending.com>"
# MAIL_FROM_ADDRESS=support@amalgatedlending.com
# MAIL_RETRY_ATTEMPTS=3
# MAIL_RETRY_DELAY_MS=750
