{
  "name": "amalgated-lending",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/clear-laravel-bind.cjs",
    "predev:full": "node scripts/clear-laravel-bind.cjs",
    "dev": "concurrently -n laravel,vite -c blue,green \"npm run serve:laravel\" \"npm run dev:vite\"",
    "serve:laravel": "node scripts/serve-laravel.cjs",
    "serve:chat": "cd chat-server && node server.js",
    "dev:vite": "npx vite --config frontend/vite.config.js",
    "dev:vite:delayed": "node scripts/wait-laravel.cjs && npx vite --config frontend/vite.config.js",
    "dev:vite:full": "node scripts/wait-laravel.cjs && node scripts/wait-chat.cjs && npx vite --config frontend/vite.config.js",
    "dev:full": "concurrently -n laravel,chat,vite -c blue,magenta,green \"npm run serve:laravel\" \"npm run serve:chat\" \"npm run dev:vite:full\"",
    "dev:full:chat": "npm run dev:full",
    "lockfile:sync": "npm install --package-lock-only",
    "build": "npx vite build --config frontend/vite.config.js",
    "build:laravel": "npm run build && node scripts/sync-spa-to-laravel-public.cjs",
    "build:full": "npm run build",
    "lint": "eslint .",
    "preview": "npx vite preview --config frontend/vite.config.js",
    "perf:baseline": "node scripts/perf-baseline.cjs",
    "composer:install": "composer install --optimize-autoloader --working-dir=amalgated-lending-api",
    "composer:install:prod": "composer install --optimize-autoloader --no-dev --working-dir=amalgated-lending-api",
    "api:cache": "cd amalgated-lending-api && php artisan config:cache && php artisan route:cache && php artisan view:cache"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "6.15.2",
    "@aws-amplify/ui-react-liveness": "^3.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "aws-amplify": "^6.16.3",
    "axios": "^1.16.0",
    "framer-motion": "^12.35.0",
    "gsap": "^3.14.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.0",
    "socket.io-client": "^4.8.3",
    "zod": "^3.25.17"
  },
  "overrides": {
    "@aws-amplify/ui-react": "6.15.2",
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.2.1",
    "@aws-amplify/backend-cli": "^1.7.2",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.100.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
