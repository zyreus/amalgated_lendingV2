{
  "name": "amalgated-lending",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/clear-laravel-bind.cjs",
    "predev:full": "node scripts/clear-laravel-bind.cjs",
    "dev": "concurrently -n laravel,chat,vite -c blue,magenta,green \"npm run serve:laravel\" \"npm run serve:chat\" \"npm run dev:vite:full\"",
    "dev:laravel-vite": "concurrently -n laravel,vite -c blue,green \"npm run serve:laravel\" \"npm run dev:vite\"",
    "artisan": "node scripts/artisan.cjs",
    "migrate": "node scripts/artisan.cjs migrate",
    "serve:laravel": "node scripts/serve-laravel.cjs",
    "serve:octane": "node scripts/serve-octane.cjs",
    "octane:benchmark": "node scripts/octane-benchmark.cjs",
    "serve:chat": "cd chat-server && node server.js",
    "dev:vite": "npx vite --config frontend/vite.config.js",
    "dev:vite:delayed": "node scripts/wait-laravel.cjs && npx vite --config frontend/vite.config.js",
    "dev:vite:full": "node scripts/wait-laravel.cjs && node scripts/wait-chat.cjs && npx vite --config frontend/vite.config.js",
    "dev:full": "npm run dev",
    "dev:full:chat": "npm run dev",
    "lockfile:sync": "npm install --package-lock-only",
    "build": "npx vite build --config frontend/vite.config.js",
    "build:laravel": "npm run build && node scripts/sync-spa-to-laravel-public.cjs",
    "build:full": "npm run build",
    "lint": "eslint .",
    "preview": "npx vite preview --config frontend/vite.config.js",
    "perf:baseline": "node scripts/perf-baseline.cjs",
    "composer:install": "composer install --optimize-autoloader --working-dir=amalgated-lending-api",
    "composer:install:prod": "composer install --optimize-autoloader --no-dev --working-dir=amalgated-lending-api",
    "api:clear": "node scripts/artisan.cjs route:clear && node scripts/artisan.cjs config:clear && node scripts/artisan.cjs view:clear",
    "optimize:clear": "node scripts/artisan.cjs optimize:clear",
    "api:cache": "node scripts/artisan.cjs route:clear && node scripts/artisan.cjs config:cache && node scripts/artisan.cjs route:cache && node scripts/artisan.cjs view:cache",
    "pm2:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pm2-reset.ps1",
    "pm2:preflight": "node scripts/pm2-preflight.cjs --clear-stale-ports",
    "pm2:start": "node scripts/pm2-start-ordered.cjs",
    "pm2:restart": "node scripts/pm2-preflight.cjs --clear-stale-ports && node scripts/pm2-run.cjs restart amalgated-backend --update-env && node scripts/wait-backend-health.cjs && node scripts/pm2-run.cjs restart amalgated-chat amalgated-frontend --update-env",
    "pm2:stop": "node scripts/pm2-run.cjs stop all",
    "pm2:delete": "node scripts/pm2-run.cjs delete all",
    "pm2:status": "node scripts/pm2-run.cjs list",
    "pm2:show": "node scripts/pm2-run.cjs describe",
    "pm2:logs": "node scripts/pm2-run.cjs logs",
    "pm2:health": "node scripts/pm2-health-check.cjs",
    "pm2:stability": "node scripts/pm2-stability-watch.cjs --minutes=5"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "6.15.4",
    "@aws-amplify/ui-react-liveness": "3.6.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "aws-amplify": "^6.18.0",
    "axios": "^1.16.0",
    "framer-motion": "^12.35.0",
    "gsap": "^3.14.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.17.0",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.0",
    "socket.io-client": "^4.8.3",
    "zod": "^3.25.17"
  },
  "overrides": {
    "@aws-amplify/ui-react": "6.15.4",
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.2.1",
    "@aws-amplify/backend-cli": "^1.7.2",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.100.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pm2": "^6.0.14",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
